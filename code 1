#include <stdio.h>
#include <string.h>

int main() {
    char s1[50], s2[50], rev[50];
    int n, i;

    printf("Enter main string: ");
    scanf("%s", s1);
    printf("Enter second string: ");
    scanf("%s", s2);

    n = strlen(s1);

    // a. Substring
    if(strstr(s1, s2))
        printf("\n a. Substring: YES - '%s' found in '%s'", s2, s1);
    else
        printf("\n a. Substring: NO - '%s' not found in '%s'", s2, s1);

    // e. Reverse calculation
    for(i = 0; i < n; i++) {
        rev[i] = s1[n - i - 1];
    }
    rev[n] = '\0';

    // b. Palindrome
    if(strcmp(s1, rev) == 0)
        printf("\n b. Palindrome: YES");
    else
        printf("\n b. Palindrome: NO");

    // c. Compare
    if(strcmp(s1, s2) == 0)
        printf("\n c. Compare: Strings are EQUAL");
    else
        printf("\n c. Compare: Strings are NOT EQUAL");

    // d. Copy
    strcpy(s2, s1);
    printf("\n d. Copy: %s", s2);

    // e. Reverse Print (from the top of the new image)
    printf("\n e. Reverse: %s\n", rev);

    return 0;
}
