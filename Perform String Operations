#include <stdio.h>
#include <string.h>

void get_substring(const char *src, int start, int len, char *dest) {
    int i;
    for (i = 0; i < len && src[start + i] != '\0'; i++) {
        dest[i] = src[start + i];
    }
    dest[i] = '\0';
}

int is_palindrome(const char *str) {
    int len = strlen(str);
    for (int i = 0; i < len / 2; i++) {
        if (str[i] != str[len - 1 - i]) return 0;
    }
    return 1;
}

int compare_strings(const char *s1, const char *s2) {
    int i = 0;
    while (s1[i] != '\0' && s2[i] != '\0') {
        if (s1[i] != s2[i]) return s1[i] - s2[i];
        i++;
    }
    return s1[i] - s2[i];
}

void copy_string(char *dest, const char *src) {
    int i = 0;
    while ((dest[i] = src[i]) != '\0') i++;
}

void reverse_string(char *str) {
    int len = strlen(str);
    for (int i = 0; i < len / 2; i++) {
        char temp = str[i];
        str[i] = str[len - 1 - i];
        str[len - 1 - i] = temp;
    }
}

int main() {
    char str1[100] = "madam", str2[100], sub[100];

    // Substring
    get_substring(str1, 1, 3, sub);
    printf("Substring (1,3) of '%s': %s\n", str1, sub);

    // Palindrome
    printf("Is '%s' a palindrome? %s\n", str1, is_palindrome(str1) ? "Yes" : "No");

    // Compare
    printf("Compare '%s' and 'apple': %d\n", str1, compare_strings(str1, "apple"));

    // Copy
    copy_string(str2, str1);
    printf("Copied string: %s\n", str2);

    // Reverse
    reverse_string(str2);
    printf("Reversed string: %s\n", str2);

    return 0;
}
